{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# /api vers le PostgREST de l'appli, le reste vers son site
(app) {
	encode gzip
	handle_path /api/* {
		reverse_proxy {args[0]}-api:3000
	}
	handle {
		root * /srv/{args[0]}
		header Cache-Control "no-cache"
		file_server
	}
}

ekus.dromnas.win {
	import app ekus
}

# accès de secours sans domaine : http://192.168.1.31:8086
:8086 {
	import app ekus
}

vault.dromnas.win {
	@test method HEAD
	header @test {
		-Cross-Origin-Resource-Policy
		defer
	}
	encode gzip
	reverse_proxy vault:80
}

ptcg.dromnas.win {
	handle_path /nas/* {
		reverse_proxy ptcg-nas:80
	}
	import app ptcg
}

hub.dromnas.win {
	import app hub
}

# l'interface d'UGOS, en HTTPS
nas.dromnas.win {
	reverse_proxy 192.168.1.31:9999
}
