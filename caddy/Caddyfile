{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# /api vers le PostgREST de l'appli, /_shared vers le kit commun, le reste vers son site
(app) {
	encode gzip
	handle_path /api/* {
		reverse_proxy {args[0]}-api:3000
	}
	handle_path /_shared/* {
		root * /srv-shared
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /srv/{args[0]}
		header Cache-Control "no-cache"
		file_server
	}
}

# L'adresse vérifiée par Cloudflare Access ouvre le profil Ekus (v2.entrer) : elle n'est crue
# que si elle arrive par le tunnel, c'est-à-dire du réseau famille. Ailleurs (Tailscale), on l'efface.
# FAMILLE_RESEAU absent du .env : adresse de test qui ne correspond à rien, personne n'entre par e-mail.
ekus.dromnas.win {
	@hors_tunnel not remote_ip {$FAMILLE_RESEAU:192.0.2.1/32}
	request_header @hors_tunnel -Cf-Access-Authenticated-User-Email
	import app ekus
}

# accès de secours sans domaine : http://192.168.1.31:8086 (par code, jamais par e-mail)
:8086 {
	request_header -Cf-Access-Authenticated-User-Email
	import app ekus
}

vault.dromnas.win {
	@test method HEAD
	header @test {
		-Cross-Origin-Resource-Policy
		defer
	}
	encode gzip
	reverse_proxy vault:80
}

ptcg.dromnas.win {
	handle_path /nas/* {
		reverse_proxy ptcg-nas:80
	}
	import app ptcg
}

hub.dromnas.win {
	# relevé du NAS écrit par le conteneur cron (backup/etat.sh)
	handle /etat.json {
		root * /srv-etat
		header Cache-Control "no-store"
		file_server
	}
	import app hub
}

# l'interface d'UGOS, en HTTPS
nas.dromnas.win {
	reverse_proxy 192.168.1.31:9999
}

daglega.dromnas.win {
	encode gzip
	# l'appli envoie une clé factice, PostgREST n'a pas de secret JWT
	handle_path /rest/v1/* {
		reverse_proxy daglega-api:3000 {
			header_up -Authorization
		}
	}
	handle /upload {
		reverse_proxy daglega-uploads:3005
	}
	handle /files/* {
		reverse_proxy daglega-uploads:3005
	}
	handle {
		root * /srv/daglega
		header Cache-Control "no-cache"
		file_server
	}
}

frambod.dromnas.win {
	import app frambod
}

# les job_* ne sont appelés que par le cron, par le réseau Docker
signal.dromnas.win {
	handle /api/rpc/job_* {
		respond 404
	}
	handle {
		import app signal
	}
}

codex.dromnas.win {
	# le dépôt est servi depuis sa racine : on cache les scripts SQL et .git
	handle /db/* {
		respond 404
	}
	handle /.git/* {
		respond 404
	}
	import app codex
}
