# dump de toutes les bases, juste avant les instantanés de 3 h
30 2 * * * /backup/dump.sh >> /volume1/backup/dumps/cron.log 2>&1
# sauvegarde PTCG, visible dans ses Réglages
45 2 * * * /volume1/docker/repos/ptcg/jobs/backup.sh >> /volume1/docker/repos/ptcg/jobs/backup.log 2>&1
# copie vers le Maxtor, après les instantanés de 3 h
0 4 * * * /backup/maxtor.sh 2>> /volume1/backup/maxtor.log
# Ekus : écritures du jour des échéances et des crédits (avant le dump de 2 h 30)
10 2 * * * docker exec db psql -U drom -d ekus -v ON_ERROR_STOP=1 -Atc "select now(), v2.creer_ecritures()" >> /volume1/backup/ekus/jobs.log 2>&1
