# Copier en .env (jamais commité) puis remplir
PG_PASSWORD=
CF_API_TOKEN=
# jeton du tunnel Cloudflare (accès famille)
TUNNEL_TOKEN=
# sous-réseau du réseau Docker famille (docker network inspect dromnas_famille)
FAMILLE_RESEAU=
# Ekus : synchro des e-mails des profils vers la politique Access « Ekus famille »
# jeton Cloudflare limité à « Access: Apps and Policies » (modification), identifiants du compte et de la politique
CF_ACCESS_TOKEN=
CF_ACCOUNT_ID=
CF_EKUS_POLICY_ID=
# vide : la synchro écrit seulement ce qu'elle changerait ; 1 : elle l'applique
EKUS_ACCES_ACTIF=

EKUS_DB_PASSWORD=
EKUS_JWT_SECRET=
PTCG_DB_PASSWORD=
PTCG_JWT_SECRET=
HUB_DB_PASSWORD=
DAGLEGA_DB_PASSWORD=
CODEX_DB_PASSWORD=
CODEX_JWT_SECRET=
FRAMBOD_DB_PASSWORD=
SIGNAL_DB_PASSWORD=

LASTFM_API_KEY=
LASTFM_USERNAME=
